{
  "expo": {
    "name": "VASTRA - Hostel Laundry",
    "slug": "rvsu-svcet",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rvsu.vastra",
      "icon": "./assets/ios/icon-1024.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "VASTRA"
      }
    },
    "android": {
      "package": "com.rvsu.vastra",
      "versionCode": 7,
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow VASTRA to access the camera to scan student laundry token QR codes and capture verification photos.",
          "microphonePermission": "VASTRA does not record audio. The camera is used only to scan laundry token QR codes and take clothes verification photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow VASTRA to access your camera to take clothes verification photos for laundry intake.",
          "photosPermission": "Allow VASTRA to access your photos so you can attach pictures of your clothes to a laundry request or set your profile photo.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/ios/splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-secure-store"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "067880e4-14c3-4eab-ae71-7793eabf71fd"
      }
    }
  }
}
