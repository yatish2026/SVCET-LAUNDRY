<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Auth-Token, X-Requested-With, Accept"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Handle preflight OPTIONS requests directly
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>

# Allow reasonable POST payload sizes for compressed photos
LimitRequestBody 10485760

# Never serve the server config or helper files directly
<FilesMatch "^(config\.php|config\.sample\.php|auth\.php|db\.php)$">
    Require all denied
</FilesMatch>
